# Environment variables for Prashikshan Node.js Backend

# PostgreSQL Database connection string (Supabase direct / pooled connection)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"

# Supabase Project Configuration for Auth Verification
SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
SUPABASE_PUBLISHABLE_KEY="[YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY]"

# Express Server Port
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV="development"

# Optional: Supabase Service Role Key (Used only for admin-level user provisioning / bypass email rate limits in ERP setup)
# WARNING: NEVER commit or expose this key.
# SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# Supabase Auth Send Email Hook Configuration (Bypasses built-in 2-4 emails/hr quota)
# Generate SEND_EMAIL_HOOK_SECRET in Supabase Dashboard -> Authentication -> Hooks -> Send Email Hook
SEND_EMAIL_HOOK_SECRET="v1,whsec_[YOUR-HOOK-SECRET]"

# Transactional Email Provider (Resend API)
# Free tier: 3,000 emails/month (100 emails/day)
RESEND_API_KEY="re_[YOUR-RESEND-API-KEY]"
EMAIL_FROM="Prashikshan Portal <onboarding@resend.dev>"
