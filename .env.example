# Prashikshan Flutter Application Environment Variables
# Copy this file to .env and provide your actual values.
# Do NOT commit .env with real credentials.

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Express Backend Integration URL
# Defaults:
# - Android Emulator: http://10.0.2.2:3000
# - Web / Windows / macOS / Linux: http://localhost:3000
# - Custom: set BACKEND_URL explicitly (e.g. https://api.prashikshan.college.edu)
BACKEND_URL=http://localhost:3000

# Feature Flag: Route Student Monitoring through Node.js Express Backend
# Set to 'true' to use the Express + Prisma backend API for Student Monitoring.
# Set to 'false' to query Supabase directly via the Flutter Supabase SDK.
USE_BACKEND_API=true
